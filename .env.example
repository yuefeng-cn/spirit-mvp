# Anthropic / endpoint configuration
# The model id to use for the conversation loop.
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional: override the API base url (e.g. for a proxy / compatible endpoint).
# Leave empty to use the default https://api.anthropic.com
ANTHROPIC_BASE_URL=

# API key — required unless your endpoint is unauthenticated.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
